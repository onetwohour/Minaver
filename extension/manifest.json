{
  "manifest_version": 3,
  "name": "Minaver",
  "version": "1.2.0",
  "description": "네이버의 시작 화면을 간소화합니다.",
  "homepage_url": "https://github.com/onetwohour/Minaver",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Minaver 설정",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.naver.com/",
        "http://www.naver.com/"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
